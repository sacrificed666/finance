# The public address of the app, for sign-in links and passkeys
AUTH_URL=http://localhost:3000
# Signs the sessions: openssl rand -base64 32
AUTH_SECRET=
# Encrypts every record in the database: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Optional: the key before the last rotation, so older records still open
DATA_ENCRYPTION_KEY_PREVIOUS=
# Optional: the only email that may sign up, and that sees the server errors
OWNER_EMAIL=
# Optional: open or closed; without OWNER_EMAIL, staging and production keep sign-up closed
REGISTRATION=
# How many proxies stand in front of the app and add to X-Forwarded-For
TRUSTED_PROXY_HOPS=1
# Optional: Google sign-in, from https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Postgres outside Docker; Docker builds it from the POSTGRES_ settings below
DATABASE_URL=
# How many connections the app keeps open to Postgres
DATABASE_POOL_MAX=10
# Docker only: the database the db service creates
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finance_tracker
# Docker only: the host address and ports of the app and the database
APP_HOST=
APP_PORT=
POSTGRES_PORT=
# The time zone and hour of the morning push notes; REMINDERS=off stops them
TZ=Europe/Kyiv
REMINDER_HOUR=9
REMINDERS=
# Optional: the contact push services see, a mailto: or https: address
VAPID_SUBJECT=
# Docker production only: nightly backups, kept for days, copied offsite with rclone
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
BACKUP_REMOTE=
BACKUP_REMOTE_KEEP_DAYS=90
# Optional: encrypts offsite copies for this age recipient
BACKUP_AGE_RECIPIENT=
# Docker development only: the hour of the daily dump of the dev database
DEV_BACKUP_HOUR=12

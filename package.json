{
  "name": "finance",
  "version": "1.0.0",
  "private": true,
  "description": "A self-hosted personal finance tracker for money in more than one currency, built with Next.js, React and PostgreSQL, in ten languages.",
  "license": "MIT",
  "author": "Illia Movchko (https://github.com/sacrificed666)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sacrificed666/finance.git"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:text": "node scripts/check-text.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run lint:text && npm run format:check && npm run typecheck && npm run test:run"
  },
  "dependencies": {
    "@auth/pg-adapter": "^1.11.3",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "country-flag-icons": "^1.6.20",
    "jsqr": "^1.4.0",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-socket": "^0.2.16",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.1.2",
    "lighthouse": "~13.5.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "sass": "^1.106.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@auth/core": {
      "@simplewebauthn/browser": "$@simplewebauthn/browser",
      "@simplewebauthn/server": "$@simplewebauthn/server"
    },
    "next-auth": {
      "@simplewebauthn/browser": "$@simplewebauthn/browser",
      "@simplewebauthn/server": "$@simplewebauthn/server"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "fsevents": false
  },
  "monitor": {
    "paths": [
      "/healthz",
      "/healthz?db=1",
      "/login",
      "/.well-known/security.txt",
      "/robots.txt"
    ],
    "pages": [
      "/login"
    ]
  }
}
